cat <<EOF >/etc/profile.d/opencode.sh
export PATH="${SDK}/bin:\$PATH"
EOF

# wl-clipboard and xclip are required for clipboard support in some terminals.
apt-get update
apt-get install wl-clipboard xclip

# Install the SDK's instruction
install -D -m644 "${SDK}/workshop-prompt.md" "/etc/opencode/instructions/workshop-prompt.md"

apt-get install -y jq

# Use the system managed config directory
_config="/etc/opencode/opencode.json"
if [ ! -f "${_config}" ]; then
	# No existing config: install the SDK's opencode.json as-is.
	install -m644 "${SDK}/opencode.json" "${_config}"
else
	# Merge the SDK's opencode.json fragments into the existing config.
	_merged=$(jq -s '.[0] * .[1]' "${_config}" "${SDK}/opencode.json")
	echo "${_merged}" > "${_config}"
fi

# OpenCode 2.x no longer reads the system-managed /etc/opencode directory, so
# point it at the same config explicitly. This file is read by the OpenCode
# background server, which inherits the environment of the shell that starts it.
#
# NOTE: as of 2.0.21 OpenCode 2.x parses the "instructions" key but never loads
# the files it lists, so the workshop prompt is not applied on 2.x until the
# upstream fix lands (https://github.com/anomalyco/opencode/issues/51341, fix
# in https://github.com/anomalyco/opencode/pull/51422). No SDK change is needed
# once a fixed release is picked up by Renovate.
if [[ "$(cut -d. -f1 "${SDK}/version")" == "2" ]]; then
	cat <<EOF2 >>/etc/profile.d/opencode.sh
export OPENCODE_CONFIG="${_config}"
EOF2
fi
