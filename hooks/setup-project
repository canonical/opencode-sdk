mkdir -p "$HOME/.config/opencode"

# Install the SDK's AGENTS.md only on first run. Once it exists — whether
# unchanged from the SDK or user-customised — refreshes leave it alone.
# To pull in an updated SDK prompt, delete the file and run `workshop refresh`.
#
# OpenCode reads ~/.config/opencode/AGENTS.md natively as global rules
# (see opencode.ai/docs/rules), so no wrapper is needed.
if [[ ! -f "$HOME/.config/opencode/AGENTS.md" ]]; then
    install -m644 "${SDK}/workshop-prompt.md" "$HOME/.config/opencode/AGENTS.md"
fi
