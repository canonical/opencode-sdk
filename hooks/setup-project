#!/bin/bash
set -eu

_unit="$HOME/.config/systemd/user/opencode.service"
mkdir -p "$(dirname "$_unit")"
cat >"$_unit" <<EOF
[Unit]
Description=OpenCode background server
After=default.target

[Service]
Type=simple
ExecStart="$SDK/bin/opencode" serve --service
Environment="OPENCODE_CONFIG=/etc/opencode/opencode.json"
Environment="PATH=$SDK/bin:/usr/local/bin:/usr/bin:/bin"
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
EOF

systemctl --user daemon-reload
systemctl --user enable opencode.service
systemctl --user restart opencode.service
