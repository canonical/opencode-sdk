if ! status="$(sudo -u workshop --login opencode service status 2>/dev/null)"; then
  workshopctl set-health --code="opencode-service-unavailable" error \
    "OpenCode service is unavailable."
  exit 0
fi

if [[ "$status" != http* ]]; then
  workshopctl set-health --code="opencode-service-not-running" waiting \
    "OpenCode background service is starting."
  exit 0
fi

workshopctl set-health okay
